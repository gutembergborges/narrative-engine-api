# .env.example: the list of environment variables this project understands.
#
# How to use it:
#   cp .env.example .env
# Then edit .env. Docker Compose reads .env automatically.
# .env is in .gitignore and must never be committed. This file has no real secrets.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=narrative
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=narrative_engine
# Port on YOUR machine. Change it if you already run PostgreSQL locally on 5432.
POSTGRES_PORT=5432

# --- Redis (used by docker-compose.yml) ---
# Port on YOUR machine. Change it if 6379 is taken.
REDIS_PORT=6379

# --- Application (nothing reads these yet; the settings module is a Milestone 1 issue) ---
# DATABASE_URL=postgresql+psycopg://narrative:change-me-local-only@localhost:5432/narrative_engine
# REDIS_URL=redis://localhost:6379/0
